# Frontend (browser-visible). Only the Supabase URL and the publishable/anon key belong here.
# Leave both empty to run the app in local DEMO MODE (browser storage, simulated email inbox).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: "hash" for sub-path hosting (review previews); default is normal browser routing.
VITE_ROUTER_MODE=
VITE_BASE=/

# Optional LLM adapter is disabled by default and is not used by any core feature.
VITE_AI_PROVIDER=disabled

# Never expose service-role keys, SMTP credentials or retailer secrets to the browser.
# Hosted SMTP credentials are entered in the Supabase Dashboard (Authentication -> SMTP Settings).
# Edge Functions read SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY from Supabase itself.
